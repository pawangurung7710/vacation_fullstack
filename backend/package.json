{
  "name": "trekkers-squad-backend",
  "version": "1.0.0",
  "description": "Production-grade REST API for The Trekkers Squad platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "seed": "node src/seeds/index.js",
    "perf:check": "node src/scripts/perf-check.js",
    "seed:clean": "node src/seeds/clean.seed.js",
    "seed:users": "node src/seeds/users.seed.js",
    "seed:team": "node src/seeds/team.seed.js",
    "seed:impact": "node src/seeds/impact.seed.js",
    "seed:faqs": "node src/seeds/faqs.seed.js",
    "seed:rentals": "node src/seeds/rentals.seed.js",
    "seed:add-ons": "node src/seeds/addOns.seed.js",
    "seed:bulk": "node src/seeds/bulk.seed.js",
    "seed:all": "npm run seed:clean && npm run seed:users && npm run seed:bulk && npm run seed:team && npm run seed:faqs && npm run seed:rentals && npm run seed:add-ons"
