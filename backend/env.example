# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/trekkers-squad

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=The Trekkers Squad
SMTP_FROM_EMAIL=your-email@gmail.com
BOOKING_NOTIFICATION_EMAIL=bookings@trekkerssquad.example
CONTACT_NOTIFICATION_EMAIL=hello@trekkerssquad.example

# Frontend URL (for CORS - optional, additional origin)
# Allowed origins are configured in app.js:
# - https://dev.trekkerssquad.example (dev)
# - https://www.trekkerssquad.example (production)
# - http://localhost:5173 (local development)
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Admin User (for seeding)
ADMIN_EMAIL=admin@trekkerssquad.example
ADMIN_PASSWORD=admin123456
BOOKING_QR_SECRET=replace-with-strong-secret
